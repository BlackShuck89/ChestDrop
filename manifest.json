{
  "manifest_version": 3,
  "name": "ChestDrop for ImgChest",
  "description": "Right-click images to upload to ImgChest. Local settings, export/import backups, SFW/NSFW defaults.",
  "version": "0.1.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "chestdrop-imgchest@extensions.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "menus",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.imgchest.com/*"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "image-reader.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "ChestDrop for ImgChest",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
